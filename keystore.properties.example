# 复制为 keystore.properties（已 gitignore）并填入真实值。
# 签名材料 release/hypercar.p12 与生成清单见 release/ 目录（勿提交）。
#
# 注意：本 keystore 是 PKCS12，storePassword 与 keyPassword **必须相同**
# （openssl pkcs12 -export 只有单一密码）。两者填不同值会报
# "keystore password was incorrect"。
storeFile=release/hypercar.p12
storeType=PKCS12
storePassword=
keyAlias=hypercar
keyPassword=
